+/// SPICE3f5 drain-source voltage step limiter (`limvds`), the companion of [`fetlim`].
+#[inline]
+pub fn limvds(vnew: f64, vold: f64) -> f64 {
+    if vold >= 3.5 {
+        if vnew > vold {
+            vnew.min(3.0 * vold + 2.0)
+        } else if vnew < 3.5 {
+            vnew.max(2.0)
+        } else {
+            vnew
+        }
+    } else if vnew > vold {
+        vnew.min(4.0)
+    } else {
+        vnew.max(-0.5)
+    }
+}
+
+/// Level-1 threshold voltage (polarised frame) for a given bulk-source voltage.
+#[inline]
+fn mos1_von(vt0: f64, gamma: f64, phi: f64, vbs: f64) -> f64 {
+    if gamma > 0.0 {
+        let sqrt_phi = phi.sqrt();
+        if vbs <= 0.0 {
+            vt0 + gamma * ((phi - vbs).sqrt() - sqrt_phi)
+        } else {
+            vt0 - gamma * vbs / (2.0 * sqrt_phi)
+        }
+    } else {
+        vt0
+    }
+}
