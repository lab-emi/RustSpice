+/// Largest diode exponent argument `v_d / (n * V_t)` that is evaluated with the exact exponential.
+///
+/// `exp(600) ~ 3.8e260` leaves 48 decades of headroom below the f64 overflow threshold, so the
+/// linear continuation above it stays finite for any argument below ~1e47 and `Is * exp(600)` stays
+/// finite for any saturation current below ~1e47 A. Above this argument the model continues
+/// linearly with matching value and slope (a C1 continuation, so the Newton linearization stays
+/// consistent), and the nonlinear solver refuses to accept an operating point in that region
+/// instead of reporting numbers from the continuation.
+pub const DIODE_EXP_ARG_MAX: f64 = 600.0;
+
+/// Shockley exponential `e^arg` and its derivative with respect to `arg`, evaluated exactly up to
+/// [`DIODE_EXP_ARG_MAX`] and continued linearly (value and slope matched) above it.
+#[inline]
+pub fn diode_exp(arg: f64) -> (f64, f64) {
+    let a = arg.min(DIODE_EXP_ARG_MAX);
+    let e = a.exp();
+    // `arg - a` is zero below the cap, so the continuation term vanishes without a branch.
+    (e * (1.0 + (arg - a)), e)
+}
