+    #[test]
+    fn diode_exp_is_exact_below_the_cap_and_c1_continuous_above() {
+        for &a in &[-3.0, 0.0, 1.0, 80.0, 193.3, 599.0, DIODE_EXP_ARG_MAX] {
+            let (e, de) = diode_exp(a);
+            assert_eq!(e, a.exp());
+            assert_eq!(de, a.exp());
+        }
+        let cap = DIODE_EXP_ARG_MAX.exp();
+        let (e_hi, de_hi) = diode_exp(DIODE_EXP_ARG_MAX + 10.0);
+        assert!((e_hi / (cap * 11.0) - 1.0).abs() < 1e-15, "value must continue linearly");
+        assert_eq!(de_hi, cap, "slope must match the exact exponential at the cap");
+        let (e_far, _) = diode_exp(1.0e6);
