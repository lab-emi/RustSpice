+/// Matrices smaller than this are factored in their natural order (their fill is bounded).
+const ORDERING_MIN_DIM: usize = 32;
+/// Work budget (sum of squared degrees) of the minimum-degree ordering; beyond it the natural
+/// order is kept and the symbolic LU's own operation budget decides between the tiers.
+const ORDERING_WORK_BUDGET: usize = 20_000_000;
+
+/// Deterministic greedy minimum-degree ordering of the pattern of `A + A^T`.
+/// Returns `order[new] = old`, or `None` when the work budget is exhausted.
+fn min_degree_order(csc: &CscMatrix<f64>, work_budget: usize) -> Option<Vec<usize>> {
+    use std::cmp::Reverse;
+    use std::collections::BinaryHeap;
+
+    let n = csc.nrows;
+    let mut adj: Vec<Vec<usize>> = vec![Vec::new(); n];
+    for c in 0..n {
+        for idx in csc.col_ptr[c]..csc.col_ptr[c + 1] {
+            let r = csc.row_idx[idx];
+            if r != c {
+                adj[c].push(r);
+                adj[r].push(c);
+            }
+        }
+    }
+    for a in &mut adj {
+        a.sort_unstable();
+        a.dedup();
+    }
+    let mut alive = vec![true; n];
+    let mut heap: BinaryHeap<Reverse<(usize, usize)>> =
+        (0..n).map(|v| Reverse((adj[v].len(), v))).collect();
+    let mut order = Vec::with_capacity(n);
+    let mut work = 0usize;
+    let mut merged: Vec<usize> = Vec::new();
+    while let Some(Reverse((deg, v))) = heap.pop() {
+        if !alive[v] || adj[v].len() != deg {
+            continue;
+        }
+        alive[v] = false;
+        order.push(v);
+        let nb = std::mem::take(&mut adj[v]);
+        work += nb.len() * nb.len() + nb.len();
+        if work > work_budget {
+            return None;
+        }
+        for &u in &nb {
+            // adj[u] <- (adj[u] U nb) \ {u, v}, both lists sorted
+            merged.clear();
+            let (mut i, mut j) = (0usize, 0usize);
+            let a = &adj[u];
+            while i < a.len() || j < nb.len() {
+                let next = if j >= nb.len() || (i < a.len() && a[i] < nb[j]) {
+                    i += 1;
+                    a[i - 1]
+                } else if i >= a.len() || nb[j] < a[i] {
+                    j += 1;
+                    nb[j - 1]
+                } else {
+                    i += 1;
+                    j += 1;
+                    a[i - 1]
+                };
+                if next != u && next != v {
+                    merged.push(next);
+                }
+            }
+            adj[u].clear();
+            adj[u].extend_from_slice(&merged);
+        }
+        for &u in &nb {
+            heap.push(Reverse((adj[u].len(), u)));
+        }
+    }
+    Some(order)
+}
