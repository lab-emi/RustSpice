+/// Symmetric permutation `M = Q A Q^T` (`M[i][j] = A[q[i]][q[j]]`) under which the unrolled LU
+/// is compiled, with the gather / scatter workspaces that keep it invisible to callers.
+struct SymmetricOrdering {
+    /// `q[new] = old`.
+    q: Vec<usize>,
+    /// Maps the index of every non-zero of `A` to its slot in `M`.
+    nnz_map: Vec<usize>,
+    vals: Vec<f64>,
+    rhs: Vec<f64>,
+    sol: Vec<f64>,
+}
+
+impl SymmetricOrdering {
+    /// Orders `csc` and returns the ordering together with the permuted matrix, or `None` if the
+    /// natural order is kept.
+    fn build(csc: &CscMatrix<f64>) -> Option<(Self, CscMatrix<f64>)> {
+        let n = csc.nrows;
+        if n < ORDERING_MIN_DIM {
+            return None;
+        }
+        let q = min_degree_order(csc, ORDERING_WORK_BUDGET)?;
+        if q.iter().enumerate().all(|(i, &v)| i == v) {
+            return None;
+        }
+        let mut inv = vec![0usize; n];
+        for (new, &old) in q.iter().enumerate() {
+            inv[old] = new;
+        }
+        let mut coords = Vec::with_capacity(csc.nnz());
+        for c in 0..n {
+            for idx in csc.col_ptr[c]..csc.col_ptr[c + 1] {
+                coords.push((inv[csc.row_idx[idx]], inv[c]));
+            }
+        }
+        let mut m = CscMatrix::<f64>::from_pattern(n, n, &coords);
+        let mut nnz_map = Vec::with_capacity(csc.nnz());
+        for c in 0..n {
+            for idx in csc.col_ptr[c]..csc.col_ptr[c + 1] {
+                let k = m.find_value_index(inv[csc.row_idx[idx]], inv[c])?;
+                nnz_map.push(k);
+                m.values[k] = csc.values[idx];
+            }
+        }
+        let vals = m.values.clone();
+        Some((
+            Self {
+                q,
+                nnz_map,
+                vals,
+                rhs: vec![0.0; n],
+                sol: vec![0.0; n],
+            },
+            m,
+        ))
+    }
+
+    /// Fills `vals` (values of `M`) and `rhs` (`Q b`) from the caller's `csc` and `b`.
+    #[inline]
+    fn gather(&mut self, csc_values: &[f64], b: &[f64]) {
+        for (i, &k) in self.nnz_map.iter().enumerate() {
+            self.vals[k] = csc_values[i];
+        }
+        self.gather_rhs(b);
+    }
+
+    #[inline]
+    fn gather_rhs(&mut self, b: &[f64]) {
+        for (i, &old) in self.q.iter().enumerate() {
+            self.rhs[i] = b[old];
+        }
+    }
+
+    /// `x = Q^T sol`.
+    #[inline]
+    fn scatter(&self, x: &mut [f64]) {
+        for (i, &old) in self.q.iter().enumerate() {
+            x[old] = self.sol[i];
+        }
+    }
+}
