+}
+
+impl DenseLu {
+    fn new(n: usize) -> Self {
+        Self {
+            n,
+            a: vec![0.0; n * n],
+            perm: (0..n).collect(),
+            y: vec![0.0; n],
+        }
+    }
+
+    /// Factors `csc`; `false` if it is singular or holds non-finite values.
+    fn factor(&mut self, csc: &CscMatrix<f64>) -> bool {
+        let n = self.n;
+        self.a.fill(0.0);
+        for c in 0..n {
+            for idx in csc.col_ptr[c]..csc.col_ptr[c + 1] {
+                self.a[csc.row_idx[idx] * n + c] = csc.values[idx];
+            }
+        }
+        for (i, p) in self.perm.iter_mut().enumerate() {
+            *p = i;
+        }
+        for k in 0..n {
+            let mut p = k;
+            let mut pmax = self.a[k * n + k].abs();
+            for i in (k + 1)..n {
+                let v = self.a[i * n + k].abs();
+                if v > pmax {
+                    pmax = v;
+                    p = i;
+                }
+            }
+            if !(pmax > 0.0) || !pmax.is_finite() {
+                return false;
+            }
+            if p != k {
+                for j in 0..n {
+                    self.a.swap(k * n + j, p * n + j);
+                }
+                self.perm.swap(k, p);
+            }
+            let inv = 1.0 / self.a[k * n + k];
+            for i in (k + 1)..n {
+                let l = self.a[i * n + k] * inv;
+                self.a[i * n + k] = l;
+                if l != 0.0 {
+                    for j in (k + 1)..n {
+                        let u = self.a[k * n + j];
+                        self.a[i * n + j] -= l * u;
+                    }
+                }
+            }
+        }
+        true
+    }
+
+    fn solve(&mut self, b: &[f64], x: &mut [f64]) {
+        let n = self.n;
+        for i in 0..n {
+            let mut acc = b[self.perm[i]];
+            for j in 0..i {
+                acc -= self.a[i * n + j] * self.y[j];
+            }
+            self.y[i] = acc;
+        }
+        for i in (0..n).rev() {
+            let mut acc = self.y[i];
+            for j in (i + 1)..n {
+                acc -= self.a[i * n + j] * x[j];
+            }
+            x[i] = acc / self.a[i * n + i];
+        }
+    }
